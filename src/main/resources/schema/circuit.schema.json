{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "量子OS 回路 JSON（schema_version 1）",
  "description": "エディター補助用のスキーマ。最終判定は量子サービス（qosctl validate）が行う。rx・rz の角度パラメーター名は量子OS インターフェース仕様書に従う。",
  "type": "object",
  "required": ["schema_version", "n_qubits", "operations"],
  "properties": {
    "schema_version": {
      "description": "回路 JSON の版。1 のみ対応。",
      "const": 1
    },
    "n_qubits": {
      "description": "量子ビット数（1〜64）。実行時の上限は 20 量子ビット。",
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "operations": {
      "description": "命令列（測定込みで最大 10,000）。測定は終端に置く。",
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "required": ["op", "qubits"],
        "properties": {
          "op": {
            "description": "h・x・z・rx・rz・cx・measure",
            "enum": ["h", "x", "z", "rx", "rz", "cx", "measure"]
          },
          "qubits": {
            "description": "対象の量子ビット番号（0 始まり）。",
            "type": "array",
            "minItems": 1,
            "items": { "type": "integer", "minimum": 0, "maximum": 63 }
          }
        }
      }
    }
  }
}
