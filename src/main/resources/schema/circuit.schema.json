{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "量子OS 回路 JSON（schema_version 1）",
  "description": "エディター補助用のスキーマ（QOS-IF 0.1 3章）。最終判定は量子サービス（qosctl validate）が行う。",
  "type": "object",
  "required": ["schema_version", "n_qubits", "operations"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "description": "回路 JSON の版。1 のみ対応。",
      "const": 1
    },
    "n_qubits": {
      "description": "量子ビット数（1〜64）。実行時の上限は 20 量子ビット。",
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "operations": {
      "description": "命令列（測定込みで 1〜10,000）。measure はちょうど1つで、最後の命令。",
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "required": ["op", "qubits"],
        "properties": {
          "op": {
            "description": "h・x・z・rx・rz・cx・measure",
            "enum": ["h", "x", "z", "rx", "rz", "cx", "measure"]
          },
          "qubits": {
            "description": "対象の量子ビット番号（0 始まり、重複不可）。1量子ビットゲートは1個、cx は [制御, 標的]、measure は1個以上。",
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "integer", "minimum": 0, "maximum": 63 }
          },
          "theta": {
            "description": "rx・rz の回転角（ラジアン、有限の数値）。",
            "type": "number"
          }
        },
        "additionalProperties": false,
        "if": { "properties": { "op": { "enum": ["rx", "rz"] } } },
        "then": { "required": ["theta"] },
        "else": { "not": { "required": ["theta"] } }
      }
    }
  }
}
